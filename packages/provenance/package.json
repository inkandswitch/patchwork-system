{
  "name": "@inkandswitch/patchwork-provenance",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkandswitch/patchwork-system.git",
    "directory": "packages/provenance"
  },
  "version": "0.0.0",
  "type": "module",
  "description": "Reads back which package version wrote each change to a doc, and the Writers sidebar that shows it.",
  "author": "Ink & Switch",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w --preserveWatchOutput",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "dependencies": {
    "@inkandswitch/patchwork-filesystem": "workspace:^",
    "@inkandswitch/patchwork-providers": "workspace:^"
  },
  "peerDependencies": {
    "@automerge/automerge": "*",
    "@automerge/automerge-repo": "*"
  },
  "devDependencies": {
    "@automerge/automerge": "catalog:",
    "@automerge/automerge-repo": "catalog:",
    "@automerge/automerge-subduction": "catalog:",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
