{
  "name": "@patchwork/folder",
  "version": "3.2.1",
  "description": "folder type",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "source": "./src/index.js"
    }
  },
  "scripts": {
    "build": "node esbuild/build.ts",
    "dev": "node esbuild/watch.ts",
    "pushwatch": "pnpm dev pushwork",
    "sync": "pnpm build && npx pushwork sync",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "Ink & Switch",
  "dependencies": {
    "@inkandswitch/patchwork-bootloader": "^0.7.2",
    "@inkandswitch/patchwork-elements": "^6.0.2",
    "@inkandswitch/patchwork-filesystem": "^0.2.9",
    "@inkandswitch/patchwork-plugins": "^1.2.5"
  },
  "devDependencies": {
    "@automerge/automerge-repo": "^2.6.0-subduction.9",
    "esbuild": "^0.23.1",
    "happy-dom": "^15.11.7",
    "vitest": "^3.2.4"
  }
}
