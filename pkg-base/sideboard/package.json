{
  "name": "@chee/patchwork-sideboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "patchwork": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "source": "./src/index.tsx"
    },
    "./tools/sideboard": {
      "import": "./dist/sideboard/sideboard.js",
      "patchwork": "./dist/sideboard/sideboard.js",
      "source": "./src/sideboard/sideboard.tsx"
    },
    "./styles.css": "./dist/index.css"
  },
  "scripts": {
    "build": "node esbuild/build.ts",
    "dev": "node esbuild/watch.ts",
    "pushwatch": "pnpm dev pushwork",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inkandswitch/patchwork-bootloader": "^0.7.2",
    "@inkandswitch/patchwork-elements": "^6.0.2",
    "@inkandswitch/patchwork-providers-solid": "^0.2.8",
    "@types/debug": "^4.1.12",
    "debug": "^4.4.3",
    "solid-automerge": "^2.1.1",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@automerge/automerge": "^3.2.5",
    "@automerge/automerge-repo": "^2.6.0-subduction.9",
    "@babel/core": "7.28.4",
    "@babel/parser": "7.28.4",
    "@inkandswitch/patchwork-filesystem": "^0.2.9",
    "@inkandswitch/patchwork-plugins": "^1.2.5",
    "@node-types/node": "npm:@types/node@^24.9.1",
    "@solid-primitives/map": "^0.7.2",
    "@types/babel__core": "^7.20.5",
    "babel-preset-solid": "^1.9.9",
    "esbuild": "^0.23.1",
    "happy-dom": "^15.11.7",
    "solid-devtools": "^0.34.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^3.2.4"
  },
  "volta": {
    "node": "22.21.0"
  }
}
