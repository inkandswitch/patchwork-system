{
  "name": "@patchwork/account",
  "version": "0.0.0",
  "description": "the contact datatype and its views, plus the account picker",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "source": "./src/index.ts"
    },
    "./style.css": "./dist/index.css"
  },
  "scripts": {
    "build": "node esbuild/build.ts",
    "dev": "node esbuild/watch.ts",
    "pushwatch": "pnpm dev pushwork",
    "register": "pw-modules add \"$MODULE_SETTINGS_DOC_URL\" \"$(pushwork url)\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Ink & Switch",
  "dependencies": {
    "@automerge/automerge": "^3.2.5",
    "@automerge/automerge-repo": "^2.6.0-subduction.9",
    "@inkandswitch/patchwork-elements": "^6.0.2",
    "@inkandswitch/patchwork-filesystem": "^0.2.9",
    "@inkandswitch/patchwork-plugins": "^1.2.5",
    "@inkandswitch/patchwork-providers": "^0.5.2",
    "@kobalte/core": "^0.13.11",
    "clsx": "^2.1.1",
    "solid-automerge": "^2.1.1",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@babel/parser": "7.28.4",
    "@inkandswitch/patchwork-bootloader": "^0.7.2",
    "babel-preset-solid": "^1.9.9",
    "esbuild": "^0.23.1",
    "happy-dom": "^15.11.7",
    "typescript": "^5.8.3",
    "vite": "^7.1.9",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^3.2.4"
  }
}
