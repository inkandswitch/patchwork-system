    "@inkandswitch/patchwork": "workspace:*",
    "@inkandswitch/patchwork-bootloader": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.3.5"
  }
}
