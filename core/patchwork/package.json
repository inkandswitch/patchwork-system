{
  "name": "@inkandswitch/patchwork",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkandswitch/patchwork-system.git",
    "directory": "core/patchwork"
  },
  "version": "0.10.0",
  "author": "Ink & Switch",
  "type": "module",
  "license": "MIT",
  "description": "One import for a Patchwork site: boot sequence, vite plugin, and ambient types.",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite/patchwork-plugin.js",
      "types": "./dist/vite/patchwork-plugin.d.ts"
    },
    "./vite/build-info": {
      "import": "./dist/vite/build-info-plugin.js",
      "types": "./dist/vite/build-info-plugin.d.ts"
    },
    "./vite/config": {
      "import": "./dist/vite/config-plugin.js",
      "types": "./dist/vite/config-plugin.d.ts"
    },
    "./vite/dev": {
      "import": "./dist/vite/dev-plugin.js",
      "types": "./dist/vite/dev-plugin.d.ts"
    },
    "./vite/hashed": {
      "import": "./dist/vite/hashed-plugin.js",
      "types": "./dist/vite/hashed-plugin.d.ts"
    },
    "./vite/html": {
      "import": "./dist/vite/html-plugin.js",
      "types": "./dist/vite/html-plugin.d.ts"
    },
    "./vite/icons": {
      "import": "./dist/vite/icons.js",
      "types": "./dist/vite/icons.d.ts"
    },
    "./vite/importmap": {
      "import": "./dist/vite/importmap-plugin.js",
      "types": "./dist/vite/importmap-plugin.d.ts"
    },
    "./vite/manifest": {
      "import": "./dist/vite/manifest-plugin.js",
      "types": "./dist/vite/manifest-plugin.d.ts"
    },
    "./vite/netlify": {
      "import": "./dist/vite/netlify-plugin.js",
      "types": "./dist/vite/netlify-plugin.d.ts"
    },
    "./vite/service-worker": {
      "import": "./dist/vite/service-worker-plugin.js",
      "types": "./dist/vite/service-worker-plugin.d.ts"
    },
    "./vite/static": {
      "import": "./dist/vite/static-plugin.js",
      "types": "./dist/vite/static-plugin.d.ts"
    },
    "./head": {
      "import": "./dist/head.js"
    },
    "./site-kit": {
      "import": "./dist/site-kit/index.js",
      "types": "./dist/site-kit/index.d.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts"
    },
    "./global.css": "./dist/global.css"
  },
  "dependencies": {
    "@ark-0.6/automerge-repo": "npm:@automerge/automerge-repo@2.6.0-subduction.48",
    "@ark-0.6/automerge-repo-keyhive": "npm:@automerge/automerge-repo-keyhive@0.6.0-alpha.1",
    "@ark-0.6/automerge-repo-network-broadcastchannel": "npm:@automerge/automerge-repo-network-broadcastchannel@2.6.0-subduction.48",
    "@ark-0.6/automerge-repo-network-messagechannel": "npm:@automerge/automerge-repo-network-messagechannel@2.6.0-subduction.48",
    "@ark-0.6/automerge-repo-network-websocket": "npm:@automerge/automerge-repo-network-websocket@2.6.0-subduction.48",
    "@ark-0.6/automerge-repo-storage-indexeddb": "npm:@automerge/automerge-repo-storage-indexeddb@2.6.0-subduction.48",
    "@ark-0.6/automerge-subduction": "npm:@automerge/automerge-subduction@0.16.1",
    "@ark-0.6/keyhive": "npm:@keyhive/keyhive@0.3.0-alpha.1",
    "@ark-0.6/vanillajs": "npm:@automerge/vanillajs@2.6.0-subduction.48",
    "@automerge/automerge": "catalog:",
    "@automerge/automerge-repo": "catalog:",
    "@automerge/automerge-repo-keyhive": "catalog:",
    "@automerge/automerge-repo-storage-indexeddb": "catalog:",
    "@automerge/automerge-subduction": "catalog:",
    "@automerge/vanillajs": "catalog:",
    "@inkandswitch/patchwork-bootloader": "workspace:^",
    "@inkandswitch/patchwork-elements": "workspace:^",
    "@inkandswitch/patchwork-filesystem": "workspace:^",
    "@inkandswitch/patchwork-plugins": "workspace:^",
    "@inkandswitch/patchwork-provenance": "workspace:^",
    "@inkandswitch/patchwork-providers": "workspace:^",
    "@types/debug": "^4.1.13",
    "debug": "^4.4.3",
    "esbuild": "^0.23.1",
    "resolve.exports": "^2.0.3",
    "sharp": "^0.35.3",
    "vite-plugin-wasm": "^3.6.0"
  },
  "devDependencies": {
    "rollup": "^4.61.1",
    "vite": "^7.3.5"
  },
  "scripts": {
    "build": "tsc && node build-head.js && cp src/global.css dist/global.css && cp src/client.d.ts dist/client.d.ts && rm -rf dist/patches && mkdir -p dist/patches && cp ../../patches/@automerge__automerge-repo@*.patch dist/patches/",
    "dev": "tsc -w --preserveWatchOutput",
    "test": "vitest run"
  }
}
